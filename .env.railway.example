# =============================================================================
# CyberGuardian — Railway Production Environment Variables
# =============================================================================
# Copy these into your Railway project's "Variables" tab.
# DATABASE_URL is automatically injected by Railway when you add a PostgreSQL plugin.
# =============================================================================

# ── Core Django ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-change-this

DJANGO_DEBUG=False

# Railway injects this automatically when you attach a Postgres plugin:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Email / SMTP ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# ── SMS — Twilio ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Threat Intelligence API Keys ──────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
URLSCAN_API_KEY=your_urlscan_api_key
PHISHTANK_API_KEY=your_phishtank_api_key

# ── AI Agent (disabled by default in production — Ollama not available on Railway) ──
AGENT_ENABLED=False
# If you host Ollama externally, set:
# OLLAMA_BASE_URL=https://your-ollama-server.com
# OLLAMA_MODEL=qwen2.5:7b

# ── Optional Overrides ────────────────────────────────────────────────────────
# ALLOWED_HOSTS=guardianai.tech,www.guardianai.tech,.railway.app
# PORT=8000  (Railway sets this automatically)
